# ---- Required ----
# Bot token from the Discord developer portal.
# DISCORD_TOKEN is accepted as an alias.
MCCAP_TOKEN=

# ---- Storage ----
# Where reminders/payments/alerts JSON lives. On Railway, set this to the mount
# path of a volume (e.g. /data) or every deploy wipes the alert list.
DATA_DIR=/data

# ---- Solana ----
SOLANA_RPC=https://api.mainnet-beta.solana.com
# Wallet that receives /pay invoices. Leave blank to disable payments.
DONATION_WALLET=
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
PAY_EXPIRY_SEC=1800
PAY_POLL_SEC=10
BALANCE_POLL_SECONDS=300

# ---- Alert polling ----
# Tokens are graded by how close they are to their target and polled at
# different rates so the bot stays under DexScreener's 300 req/min limit.
POLL_TICK_SECONDS=5
POLL_HOT_SECONDS=10
POLL_WARM_SECONDS=60
POLL_COLD_SECONDS=300
POLL_UNKNOWN_SECONDS=120
HOT_BAND=0.85
WARM_BAND=0.5
DEX_MAX_REQUESTS_PER_MIN=240

# ---- Graduated-token report ----
GRADUATED_CHANNEL=
MIN_MC_DISPLAY=100000
MAX_CONCURRENT_REQUESTS=10
MORALIS_API_KEY=
BITQUERY_API_KEY=
BITQUERY_ENDPOINT=https://graphql.bitquery.io
BITQUERY_DEBUG=0

# Real-time graduation streams (Bitquery websockets). Off by default because
# they consume streaming quota; set to 1 to enable the BONK/BAGS/HEAVEN feeds.
GRAD_STREAM_ENABLE=0
GRAD_STREAM_POST=0
BITQUERY_STREAM_URL=wss://streaming.bitquery.io/eap
GRAD_STREAM_RETENTION_HOURS=72

# ---- Logging ----
LOG_LEVEL=INFO
