# ---- Required ----
# Bot token from the Discord developer portal. DISCORD_TOKEN is accepted as an alias.
MCCAP_TOKEN=

# ---- Storage ----
# Where reminders/moves/watchlists/alerts JSON lives. On Railway set this to the
# mount path of a volume (e.g. /data) or every deploy wipes the alert list.
DATA_DIR=/data

# ---- Level alert polling ----
# Tokens are graded by how close they are to their target and polled at
# different rates so the bot stays under DexScreener's ~300 req/min limit.
POLL_TICK_SECONDS=5
POLL_HOT_SECONDS=10
POLL_WARM_SECONDS=60
POLL_COLD_SECONDS=300
POLL_UNKNOWN_SECONDS=120
HOT_BAND=0.85
WARM_BAND=0.5

# ---- Momentum alerts ----
# A move alert samples its token at window/MOVE_SAMPLE_DIVISOR, never faster
# than MOVE_MIN_SECONDS, so short windows can't dominate the request budget.
MOVE_SAMPLE_DIVISOR=12
MOVE_MIN_SECONDS=30
MOVE_DEFAULT_COOLDOWN=1800
HISTORY_MAX_SAMPLES=500

# ---- Rate limiting ----
# Burst is deliberately smaller than the sustained rate: a bucket starting full
# at the rate could fire that many instantly AND that many again over the next
# minute, doubling the effective rate inside one rolling window (50+240 = 290).
DEX_MAX_REQUESTS_PER_MIN=240
DEX_BURST=50
HTTP_TIMEOUT_SECONDS=12

# ---- Watchlists ----
MAX_WATCH_PER_LIST=25

# ---- Misc ----
LOG_LEVEL=INFO
PRESENCE_REFRESH_SECONDS=300
MAX_ALERT_EVENTS=1000

# ---- Scan watching (Rick and other scanner bots) ----
# ORDER MATTERS. Enable "Message Content Intent" under Bot > Privileged Gateway
# Intents in the Discord Developer Portal FIRST, then set this to 1. Requesting
# the intent before it is granted makes Discord refuse the connection (4014);
# main.py falls back to running without it, but detection stays off until the
# portal toggle is on. No Discord approval is required for this intent.
SCAN_WATCH_ENABLE=0

# Bot user id(s) whose posts count as scans (space or comma separated).
# Leave blank to accept any bot whose message contains a resolvable mint.
# Narrowing this to Rick's id is strongly recommended.
SCANNER_BOT_IDS=
# Optional channel allowlist; blank means every channel the bot can see.
SCAN_CHANNEL_IDS=
# Ignore a repeat scan of the same token in the same server within this window.
SCAN_DEDUPE_SECONDS=900

# What to do on detection
SCAN_AUTO_WATCHLIST=1
SCAN_AUTO_WATCHLIST_NAME=scans
SCAN_POST_OPINION=1
SCAN_OPINION_MIN_SECONDS=60

# Auto-arm a momentum alert per newly scanned token. Each armed alert costs
# polling, so it is capped and expires; set SCAN_AUTO_MOVE_PCT=0 to disable.
SCAN_AUTO_MOVE_PCT=30
SCAN_AUTO_MOVE_WINDOW=3600
SCAN_AUTO_MOVE_MAX=15
SCAN_AUTO_MOVE_TTL=86400

# Performance tracking: how long each scanned token keeps being re-checked
# to find its peak, and how often.
SCAN_TRACK_HOURS=48
SCAN_TRACK_INTERVAL=300
MAX_SCAN_EVENTS=2000

# ---- Wallet presence ----
# The bot's SOL balance in its Discord status line, alongside the alert counts.
# DONATION_WALLET is accepted as an alias (that name is already provisioned).
SOLANA_WALLET=
SOLANA_RPC=https://api.mainnet-beta.solana.com
SHOW_BALANCE=1

# ---- Jupiter (holder/risk enrichment + market-cap fallback) ----
# Free and keyless. Batches up to 100 mints per request, so the whole watchlist
# is one call. Also supplies a market cap for tokens DexScreener has stopped
# returning pairs for. Set JUPITER_ENABLE=0 to turn the whole thing off.
JUPITER_ENABLE=1
JUPITER_URL=https://lite-api.jup.ag/tokens/v2/search
JUPITER_BATCH=100
JUPITER_REFRESH_SECONDS=90
JUPITER_TIMEOUT=10
JUPITER_MAX_REQUESTS_PER_MIN=30
# Flag a token in alert embeds when the top 10 wallets hold more than this.
TOP_HOLDER_WARN_PCT=50

# ---- Robinhood Crypto trading (REAL ORDERS) ----
# Off by default, and it stays off until an owner is set. Generate a keypair with
#   python scripts/generate_rh_keypair.py
# then register the PUBLIC key at the Robinhood API Credentials Portal.
# US-only, and requires an active Robinhood Crypto account.
RH_TRADING_ENABLE=0
RH_API_KEY=
RH_PRIVATE_KEY_B64=

# The ONLY Discord user id allowed to trade. McCap runs in shared servers, so
# leaving this at 0 means NOBODY can trade — it must never be read as "everyone".
RH_OWNER_ID=0

# Hard ceilings enforced before any order is sent. The daily ledger lives on the
# volume so a redeploy cannot reset it.
RH_MAX_TRADE_USD=25
RH_MAX_DAILY_USD=100
RH_CONFIRM_TIMEOUT=60
RH_TIMEOUT=15

# ---- Robinhood Chain wallets + trading (off by default; see README) ----
# RHC_TRADING_ENABLE=1
# RHC_WALLET_SECRET=            # 32+ chars, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
# RHC_TRADER_IDS=               # Discord user ids allowed to trade, comma separated
# RHC_GUILD_IDS=                # optional server allowlist
# RHC_RPC_URLS=                 # optional, comma separated; a paid endpoint first
# RHC_MAX_TRADE_USD=50
# RHC_MAX_DAILY_USD=200
# RHC_PUBLIC_REPLIES=1            # quotes/trades/balances post to the channel; 0 = everything private
# RHC_DEFAULT_SLIPPAGE_BPS=200
# RHC_MAX_SLIPPAGE_BPS=1000
# RHC_CONFIRM_TIMEOUT=60
# RHC_PENDING_BLOCK_SECONDS=900
# RHC_REQUIRE_MOUNTED_DATA_DIR=0  # the Dockerfile sets 1; keep 0 for local development

